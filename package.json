{
  "name": "voyager",
  "version": "0.1.0",
  "description": "Voyager \u2014 a local, AI-native browser for Windows, macOS, and Linux.",
  "main": "./out/main/index.js",
  "author": "Keegan Choudhury",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "dist:win": "npm run build:windows-auth && electron-vite build && electron-builder --win --x64",
    "dist:linux": "electron-vite build && electron-builder --linux --x64",
    "security:engine": "node scripts/check-electron-release.mjs",
    "security:release-config": "node scripts/verify-release-config.mjs",
    "build:windows-auth": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-auth.ps1",
    "security:native-storage": "node scripts/test-native-storage.mjs",
    "security:package": "node scripts/package-security-runtime.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@ghostery/adblocker-electron": "^2.11.3",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "electron-updater": "6.8.9",
    "jszip": "^3.10.1",
    "undici": "8.10.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.keeganarko.voyager",
    "productName": "Voyager",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "resources/**/*",
      "!resources/native/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true,
      "extraResources": [
        {
          "from": "resources/native",
          "to": "native",
          "filter": [
            "voyager-auth.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "AppImage"
      ]
    },
    "artifactName": "Voyager-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "keeganarko",
        "repo": "voyager",
        "releaseType": "draft"
      }
    ],
    "npmRebuild": false
  }
}
